    "/metrics": {
      "get": {
        "operationId": "metrics",
        "tags": [
          "Product"
        ],
        "summary": "Prometheus metrics",
        "security": [],
        "responses": {
          "200": {
            "description": "Metrics in the Prometheus text format.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-openasy-session",
        "description": "The browser session after signing in (`openasy-session` when certificates runs on plain http://localhost). Requests that change something must come from the certificates origin."
      },
      "apiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API token created under Settings \u2192 API tokens (`oa_certificates_...`): one role, always an expiry (ADR 0003)."
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Only when certificates is started by its tests or a local script: one shared token with the admin role. A production install does not have it."
      },
      "ingestToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "`CERTIFICATES_INGEST_TOKEN`: for cron jobs and CI. It can send certificates, nothing else."
      }
    },
    "responses": {
      "Problem": {
        "description": "An error, as RFC 9457 Problem Details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid-token",
              "invalid-json",
              "invalid-body",
              "invalid-pem",
              "private-key",
              "conflict",
              "not-found",
              "not-configured",
              "payload-too-large",
              "internal-error",
              "unauthenticated",
              "invalid-credentials",
              "mfa-required",
              "mfa-setup-required",
              "forbidden",
              "cross-site",
              "rate-limited"
            ],
            "description": "Stable; match on this."
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "State": {
        "type": "string",
        "enum": [
          "valid",
          "expiring",
          "critical",
          "expired",
          "not-yet-valid"
        ],
        "description": "`expiring` inside the largest warning threshold (30 days by default), `critical` inside the last 7 days."
      },
      "Warning": {
        "type": "string",
        "enum": [
          "weak-key",
          "weak-signature",
          "wildcard",
          "self-signed",
          "long-lifetime"
        ],
        "description": "`weak-key`: RSA under 2048 bits. `weak-signature`: SHA-1 or MD5. `wildcard`: a name starting with `*.`. `self-signed`: a leaf that signed itself. `long-lifetime`: a leaf valid for more than 398 days."
      },
      "Version": {
        "type": "object",
        "required": [
          "product",
          "version"
        ],
        "properties": {
          "product": {
            "const": "certificates"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ProductLink": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The product, as OpenAsy names it.",
            "examples": [
              "infrastructure"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The address people open it at.",
            "examples": [
              "https://infra.example.com"
            ]
          }
        }
      },
      "ProductList": {
        "type": "object",
        "required": [
          "products"
        ],
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductLink"
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Source": {
        "type": "object",
        "required": [
          "source",
          "position",
          "lastSeen"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Where it was seen, such as `web-1:443` or a file path."
          },
          "position": {
            "type": "integer",
            "description": "Place in the chain that was sent; 0 is the leaf."
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "Certificate": {
        "type": "object",
        "required": [
          "id",
          "subject",
          "commonName",
          "names",
          "issuer",
          "issuerCommonName",
          "serial",
          "notBefore",
          "notAfter",
          "daysLeft",
          "state",
          "keyType",
          "keyBits",
          "signature",
          "ca",
          "selfSigned",
          "warnings",
          "sources",
          "firstSeen",
          "lastSeen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The sha256 of the certificate."
          },
          "subject": {
            "type": "string"
          },
          "commonName": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Subject alternative names: `DNS:...`, `IP:...`, `email:...`, `URI:...`."
          },
          "issuer": {
            "type": "string"
          },
          "issuerCommonName": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "serial": {
            "type": "string"
          },
          "notBefore": {
            "type": "string",
            "format": "date-time"
          },
          "notAfter": {
            "type": "string",
            "format": "date-time"
          },
          "daysLeft": {
            "type": "integer",
            "description": "Whole days until notAfter; negative once expired."
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "keyType": {
            "type": "string"
          },
          "keyBits": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "signature": {
            "type": "string"
          },
          "ca": {
            "type": "boolean"
          },
          "selfSigned": {
            "type": "boolean"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warning"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "firstSeen": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CertificateList": {
        "type": "object",
        "required": [
          "certificates"
        ],
        "properties": {
          "certificates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Certificate"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass the previous page's nextCursor to get the next page."
          }
        }
      },
      "CertificateDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Certificate"
          },
          {
            "type": "object",
            "required": [
              "pem",
              "chain"
            ],
            "properties": {
              "pem": {
                "type": "string",
                "description": "The certificate. Never a key."
              },
              "chain": {
                "type": "array",
                "description": "The certificates in the inventory that signed this one, nearest first.",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "commonName",
                    "subject",
                    "notAfter",
                    "state",
                    "ca",
                    "selfSigned"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "commonName": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "subject": {
                      "type": "string"
                    },
                    "notAfter": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "state": {
                      "$ref": "#/components/schemas/State"
                    },
                    "ca": {
                      "type": "boolean"
                    },
                    "selfSigned": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      },
      "Received": {
        "type": "object",
        "required": [
          "certificates",
          "added"
        ],
        "properties": {
          "certificates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Certificate"
            }
          },
          "added": {
            "type": "integer",
            "description": "How many of them were not known before."
          }
        },
        "additionalProperties": false
      },
      "NewCertificates": {
        "type": "object",
        "required": [
          "pem"
        ],
        "additionalProperties": false,
        "properties": {
          "pem": {
            "type": "string",
            "description": "One certificate or a chain, as PEM text."
          },
          "source": {
            "type": "string"
          }
        }
      },
      "Crossing": {
        "type": "object",
        "required": [
          "threshold",
          "crossedAt",
          "certificate"
        ],
        "properties": {
          "threshold": {
            "type": "integer",
            "description": "Days left that were crossed; 0 means it expired."
          },
          "crossedAt": {
            "type": "string",
            "format": "date-time"
          },
          "certificate": {
            "$ref": "#/components/schemas/Certificate"
          }
        },
        "additionalProperties": false
      },
      "ExpiringList": {
        "type": "object",
        "required": [
          "crossings",
          "thresholds"
        ],
        "properties": {
          "crossings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Crossing"
            }
          },
          "thresholds": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "The thresholds in use, largest first."
          }
        },
        "additionalProperties": false
      },
      "Endpoint": {
        "type": "object",
        "required": [
          "id",
          "host",
          "port",
          "name",
          "source",
          "server",
          "lastProbeAt",
          "lastError",
          "chainValid",
          "chainError",
          "certificate",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "name": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ],
            "description": "The entry's name in the endpoints file; null for endpoints added here."
          },
          "source": {
            "type": "string",
            "enum": [
              "ui",
              "file"
            ],
            "description": "file: from the endpoints file (OPENASY_ENDPOINTS); removed there, so DELETE answers 409. A probe still works."
          },
          "server": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ],
            "description": "The server the endpoint runs on, by its name in the hosts file. Set from the endpoints file only."
          },
          "lastProbeAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "lastError": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "chainValid": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              }
            ],
            "description": "Whether the system's roots trust the chain and it fits the name; read apart from the chain."
          },
          "chainError": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "certificate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "commonName",
                  "notAfter",
                  "daysLeft",
                  "state"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "commonName": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "notAfter": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "daysLeft": {
                    "type": "integer"
                  },
                  "state": {
                    "$ref": "#/components/schemas/State"
                  }
                },
                "additionalProperties": false
              }
            ],
            "description": "The leaf it presented last."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "EndpointList": {
        "type": "object",
        "required": [
          "endpoints"
        ],
        "properties": {
          "endpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Endpoint"
            }
          }
        }
      },
      "NewEndpoint": {
        "type": "object",
        "required": [
          "host"
        ],
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string",
            "description": "A name or an address on the public internet."
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 443
          }
        }
      },
      "Summary": {
        "type": "object",
        "required": [
          "certificates",
          "states",
          "withWarnings",
          "endpoints",
          "failingEndpoints",
          "warnDays",
          "nextExpiry",
          "endpointsFile"
        ],
        "properties": {
          "certificates": {
            "type": "integer"
          },
          "states": {
            "type": "object",
            "required": [
              "valid",
              "expiring",
              "critical",
              "expired",
              "not-yet-valid"
            ],
            "properties": {
              "valid": {
                "type": "integer"
              },
              "expiring": {
                "type": "integer"
              },
              "critical": {
                "type": "integer"
              },
              "expired": {
                "type": "integer"
              },
              "not-yet-valid": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "withWarnings": {
            "type": "integer"
          },
          "endpoints": {
            "type": "integer"
          },
          "failingEndpoints": {
            "type": "integer"
          },
          "warnDays": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "nextExpiry": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "commonName",
                  "notAfter",
                  "daysLeft"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "commonName": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "notAfter": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "daysLeft": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "endpointsFile": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EndpointsFile"
              }
            ],
            "description": "null when OPENASY_ENDPOINTS is not set."
          }
        },
        "additionalProperties": false
      },
      "EndpointsFile": {
        "type": "object",
        "required": [
          "path",
          "appliedAt",
          "entries",
          "error",
          "warnings"
        ],
        "additionalProperties": false,
        "description": "The endpoints file (ADR 0052), shared with Uptime. It is read again within a minute of a change; a file that cannot be applied leaves the endpoints from its last good version.",
        "properties": {
          "path": {
            "type": "string"
          },
          "appliedAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ],
            "description": "When it was last read and applied; null if it never was."
          },
          "entries": {
            "type": "integer",
            "description": "Entries in the file, of every kind; only https:// and tls:// ones are endpoints here."
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ],
            "description": "Why the file on disk is not applied."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What to fix that did not stop the file from being applied."
          }
        }
      }
    }
  }
}
