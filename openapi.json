{
  "openapi": "3.1.1",
  "info": {
    "title": "OpenAsy Certificates API",
    "version": "0.4.0",
    "summary": "Every TLS certificate you have, when it expires and what is wrong with it.",
    "description": "Every screen of certificates uses this API, and so can your scripts and cron jobs (ADR 0014). Within `/api/v1` changes are additive only; anything removed is deprecated first (ADR 0024). Errors use Problem Details (RFC 9457).\n\nSend certificates as PEM text with `CERTIFICATES_INGEST_TOKEN`. Private keys are never accepted. Everything else takes the session of a signed-in person or an API token, and each operation names the role it needs (`x-openasy-role`: viewer, editor, admin; ADR 0003).\n\nSign-in, members and API tokens are under `/api/v1/auth`, provided by [@openasy/auth](https://github.com/openasy/auth#routes).",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This certificates"
    }
  ],
  "tags": [
    {
      "name": "Certificates",
      "description": "The inventory: what was seen, where, and when it expires."
    },
    {
      "name": "Endpoints",
      "description": "Addresses the server connects to itself."
    },
    {
      "name": "Product",
      "description": "Version and overview of this certificates."
    }
  ],
  "paths": {
    "/api/v1/certificates": {
      "post": {
        "operationId": "sendCertificates",
        "tags": [
          "Certificates"
        ],
        "summary": "Send certificates",
        "security": [
          {
            "ingestToken": []
          },
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Takes PEM text: one certificate or a chain, from CI, a cron job or a collector. **A body that holds a private key of any kind is refused whole** (`private-key`), before it is read and without repeating any of it; only public certificates are kept.\n\n```bash\ncat /etc/ssl/certs/shop.pem | curl -sf -X POST -H \"Authorization: Bearer $CERTIFICATES_INGEST_TOKEN\" \\\n  --data-binary @- \"https://certificates.example.com/api/v1/certificates?source=web-1:/etc/ssl/certs/shop.pem\"\n```\n\nJSON `{ \"pem\": \"...\", \"source\": \"...\" }` works too. The body may be gzipped (`Content-Encoding: gzip`), up to 1 MiB, with at most 100 certificates.\n\nTakes CERTIFICATES_INGEST_TOKEN, or an API token with the editor role.",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "Where the certificates were seen, such as `web-1:443`. Defaults to `upload`.",
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewCertificates"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Read and kept. Known certificates only get the new place and time.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Received"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "editor"
      },
      "get": {
        "operationId": "listCertificates",
        "tags": [
          "Certificates"
        ],
        "summary": "List certificates",
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Needs the viewer role.",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Only certificates in this state.",
            "schema": {
              "$ref": "#/components/schemas/State"
            }
          },
          {
            "name": "warning",
            "in": "query",
            "required": false,
            "description": "Only certificates with this warning.",
            "schema": {
              "$ref": "#/components/schemas/Warning"
            }
          },
          {
            "name": "ca",
            "in": "query",
            "required": false,
            "description": "`true`: only CAs. `false`: only leaves.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Matches names, issuer, fingerprint or where it was seen.",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "expiry",
                "name"
              ],
              "default": "expiry"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The previous page's nextCursor.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Soonest to expire first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "viewer"
      }
    },
    "/api/v1/certificates/{id}": {
      "get": {
        "operationId": "getCertificate",
        "tags": [
          "Certificates"
        ],
        "summary": "Get a certificate",
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Needs the viewer role.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The certificate's sha256.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The certificate, its PEM and the chain above it in the inventory.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "viewer"
      },
      "delete": {
        "operationId": "deleteCertificate",
        "tags": [
          "Certificates"
        ],
        "summary": "Delete a certificate",
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Needs the admin role.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The certificate's sha256.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted, with where it was seen. It comes back if it is sent or probed again."
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "admin"
      }
    },
    "/api/v1/expiring": {
      "get": {
        "operationId": "listExpiring",
        "tags": [
          "Certificates"
        ],
        "summary": "Certificates that crossed a threshold",
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Each certificate is reported once for the tightest threshold it has crossed (30, 14, 7 and 1 days by default, and 0 for expired), not again for the wider ones. For an alert that runs on a schedule, ask with `since` set to the time of the last run.\n\nNeeds the viewer role.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Only crossings at or after this time. Defaults to 24 hours ago.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tightest crossings first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpiringList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "viewer"
      }
    },
    "/api/v1/endpoints": {
      "get": {
        "operationId": "listEndpoints",
        "tags": [
          "Endpoints"
        ],
        "summary": "List endpoints",
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Needs the viewer role.",
        "responses": {
          "200": {
            "description": "By host.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EndpointList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "viewer"
      },
      "post": {
        "operationId": "createEndpoint",
        "tags": [
          "Endpoints"
        ],
        "summary": "Add an endpoint",
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "An address the server connects to with a TLS handshake to read its certificates. Only public addresses: a name that resolves to a private, loopback or link-local address is refused, here and at every probe. Certificates on private networks are reported by a collector in that network.\n\nNeeds the admin role.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEndpoint"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Added. It is probed on the next round, or with the probe operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Endpoint"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "admin"
      }
    },
    "/api/v1/endpoints/{id}": {
      "delete": {
        "operationId": "deleteEndpoint",
        "tags": [
          "Endpoints"
        ],
        "summary": "Delete an endpoint",
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Needs the admin role.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted. The certificates it found stay in the inventory."
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "admin"
      }
    },
    "/api/v1/endpoints/{id}/probe": {
      "post": {
        "operationId": "probeEndpoint",
        "tags": [
          "Endpoints"
        ],
        "summary": "Probe an endpoint now",
        "security": [
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Needs the editor role.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The endpoint with the result. A failed probe is an answer, not an error: see `lastError`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Endpoint"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-openasy-role": "editor"
      }
    },
    "/api/v1/summary": {
      "get": {
        "operationId": "getSummary",
