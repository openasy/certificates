      }
    },
    "/api/v1/version": {
      "get": {
        "operationId": "getVersion",
        "tags": [
          "Product"
        ],
        "summary": "Version",
        "security": [],
        "responses": {
          "200": {
            "description": "The running version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "operationId": "listProducts",
        "tags": [
          "Product"
        ],
        "summary": "Other products of this install",
